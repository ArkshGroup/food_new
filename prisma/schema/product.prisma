model Product {
  id               String         @id @default(uuid())
  name             String         @unique
  slug             String         @unique
  categoryId       Int?
  description      String?
  onSale           Boolean        @default(false)
  isNewProduct     Boolean        @default(false)
  isFeatured       Boolean        @default(false)
  isVisible        Boolean        @default(true)
  isWholeSale      Boolean        @default(false)
  isFlashSale      Boolean        @default(false)
  unitSellingPrice Decimal        @default(0.0) @db.Decimal(10, 2)
  specialPrice     Decimal        @default(0.0) @db.Decimal(10, 2)
  currency         CURRENCY       @default(NPR)
  stockQuantity    Int            @default(0)
  approxWeight     Decimal        @default(0.0) @db.Decimal(10, 2)
  unit             UNIT           @default(pcs)
  metaTitle        String
  metaDescription  String
  metaKeywords     String
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())
  bannerId         Int?
  videoUrl         String?
  brandId          Int?
  BulkInquiry      BulkInquiry[]
  CartItem         CartItem[]
  orderItem        OrderItem[]
  reviews          Review[]
  banner           Banner?        @relation(fields: [bannerId], references: [id])
  brand            Brand?         @relation(fields: [brandId], references: [id])
  category         Category?      @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  subBrandId       Int?
  subBrand         SubBrand?      @relation(fields: [subBrandId], references: [id])
  productPosition  Int            @default(0)
}

model ProductImage {
  id        String  @id @default(uuid())
  imageUrl  String?
  productId String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
